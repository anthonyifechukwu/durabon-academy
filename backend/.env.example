PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/durabon

# Random 32+ byte secret for signing login sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Admin sign-in credentials — store only the bcrypt hash of the password, never the plain password
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# The exact URL of your hosted frontend (e.g. https://durabon-academy.vercel.app)
CORS_ORIGIN=*
